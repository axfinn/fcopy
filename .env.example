# fcopy 环境变量示例文件
# 复制为 .env 并按需修改。
# 仅保留项目当前代码真实使用到的变量。

# 普通用户 API Key（用于 default 用户登录）
# 生成随机值: openssl rand -hex 32
CLIPBOARD_API_KEY=change_me_user_key_32hex

# 管理员 API Key（用于 admin 用户登录与管理界面）
# 生成随机值: openssl rand -hex 32
ADMIN_API_KEY=change_me_admin_key_32hex

# 服务监听端口（可省略，默认 3000）
PORT=3000

# 可选：限流配置（不设置则使用默认值）
# 每窗口允许的请求数
# RATE_LIMIT_REQUESTS=30
# 窗口时长（毫秒）
# RATE_LIMIT_WINDOW_MS=60000
# 触发限流后封禁时长（毫秒）
# RATE_LIMIT_BLOCK_DURATION_MS=300000

# 可选：自动清理多少天以前的历史内容（默认 7）
# CLEANUP_DAYS=30

# 可选：Node 运行环境标签
# NODE_ENV=production
